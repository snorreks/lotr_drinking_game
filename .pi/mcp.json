{
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server",
        "--enable",
        "flutter_app_lifecycle",
        "--description",
        "Dart/Flutter analyzer, pub.dev search, tests, hot reload, widget inspector",
        "--exposure",
        "deferred"
      ]
    }
  }
}
